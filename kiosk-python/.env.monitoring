# RCV Kiosk Machine Configuration with Monitoring
# Copy this to .env and update with your values

# API Configuration
API_BASE_URL=http://localhost:5500/api/v1

# Kiosk Identification
KIOSK_ID=kiosk-001

# Kiosk Location (for map display)
KIOSK_LAT=14.5995
KIOSK_LNG=120.9842
KIOSK_ADDRESS=RCV Office, Manila
KIOSK_CITY=Manila

# Control Server Configuration (optional, defaults shown)
# CONTROL_SERVER_HOST=0.0.0.0
# CONTROL_SERVER_PORT=8000

# Health Check Configuration (optional, defaults shown)
# HEARTBEAT_INTERVAL=30
